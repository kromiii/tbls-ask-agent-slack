# Example values for Gemini configuration
provider: gemini
modelName: gemini-1.5-pro

secret:
  slackAppToken: "xapp-..."
  slackOAuthToken: "xoxb-..."
  geminiApiKey: "AIza..."
  githubToken: "" # Optional

# Schema configuration: specify your tbls schema URLs or paths
schemaConfig:
  content: |
    schemas:
      - name: "my_db"
        path: "https://raw.githubusercontent.com/k1LoW/tbls/main/sample/mysql/schema.json"

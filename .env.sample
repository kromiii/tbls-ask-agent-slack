# Slack tokens (Required)
SLACK_APP_TOKEN=xapp-...
SLACK_OAUTH_TOKEN=xoxb-...

# LLM API keys (Set at least one depending on MODEL_NAME)
OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...

# Model configuration (Optional, default: gpt-4o)
MODEL_NAME=gpt-4o

# Additional options (Optional)
# CUSTOM_INSTRUCTION=
# DEBUG_MODE=false
# GITHUB_TOKEN=

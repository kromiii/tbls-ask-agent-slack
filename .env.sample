# Slack tokens (Required)
SLACK_APP_TOKEN=xapp-...
SLACK_OAUTH_TOKEN=xoxb-...

# LLM API key (Required)
OPENAI_API_KEY=sk-...

# OpenAI-compatible base URL (Optional, e.g. for Gemini, OpenRouter, Ollama)
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Model configuration (Optional, default: gpt-4o)
MODEL_NAME=gpt-4o
# MODEL_NAME=gemini-flash-latest

# Custom instruction for LLM (Optional)
# CUSTOM_INSTRUCTION="Always Respond in Japanese"

# Debug mode (Optional, default: false)
# DEBUG_MODE=false

# GitHub API token (Optional, for remote schema)
# GITHUB_TOKEN=

# For GitHub Enterprise Server (Optional)
# GH_HOST=git.xxx.com
# GITHUB_ENTERPRISE_TOKEN=***
